[Unit]
Description=SmartBin sorting service
After=network-online.target
Wants=network-online.target

[Service]
# Root is needed for /sys/class/pwm (hardware PWM servo)
User=root
WorkingDirectory=/home/vedant/SmartBin/firmware
ExecStart=/home/vedant/SmartBin/.venv/bin/python -m smartbin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
