[Unit]
Description=SmartBin sorting loop
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartbin/firmware
ExecStart=/usr/bin/python3 /home/pi/smartbin/firmware/main.py --config /home/pi/smartbin/firmware/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
